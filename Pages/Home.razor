    private async Task ToggleReputationAsync()
    {
        enableReputation = !enableReputation;
        statusMessage = enableReputation
            ? "IP reputation check enabled: IP searches include AbuseIPDB reputation, ASN and abuse reports"
            : "IP reputation check disabled: IP searches only match cloud provider ranges (add ;days to an IP to force a reputation check)";
        await SavePreferenceAsync(ReputationPreferenceKey, enableReputation);
    }

    private const string ReputationPreferenceKey = "albatross.ipReputation";
    private const string AiPreferenceKey = "albatross.ai";

    // Toggle preferences are remembered per browser (localStorage); failures (private mode, blocked storage) are ignored
    private async Task SavePreferenceAsync(string key, bool value)
    {
        try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, value ? "true" : "false"); }
        catch { /* storage unavailable */ }
    }

    private async Task<bool?> LoadPreferenceAsync(string key)
    {
        try
        {
            var value = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            return value == "true" ? true : value == "false" ? false : null;
        }
        catch
        {
            return null;
        }
    }

    private bool IsBusy => isSearching || isCheckingAbuse || isScanningUrl;

    // Shows what Search will do for the current input
    private string SearchModeHint
    {
        get
        {
            var input = ipAddress?.Trim() ?? string.Empty;
            if (input.Length == 0) return "Enter an IP address or a URL";
            if (UrlScanInput.LooksLikeUrl(input)) return "URL → security scan" + (enableAI ? " with AI assessment" : "");
            if (UrlScanInput.LooksLikeBareDomain(input)) return $"Looks like a domain. Add https:// to scan it as a URL";
            if (IsValidIPAddress(input))
            {
                var reputation = enableReputation || input.Contains(';');
                return reputation
                    ? "IP → cloud ranges + reputation" + (input.Contains(';') && !enableReputation ? " (forced by ;days)" : "") + (enableAI ? " with AI assessment" : "")
                    : "IP → cloud ranges only";
            }
            return "Not a valid public IP address or http(s) URL";
        }
    }
    
    private void ToggleJsonDisplay()
    {
        showJson = !showJson;
        
        // The JSON tree container div is recreated each time the panel is shown, so flag a rebuild
        if (showJson && !string.IsNullOrEmpty(formattedJson))
        {
            jsonTreeNeedsRender = true;
        }
    }

    private void ToggleJsonExpand()
    {
        jsonExpanded = !jsonExpanded;
    }

    private void ToggleSummaryDisplay()
    {
        showSummary = !showSummary;

        // The map container div is destroyed when hidden and recreated when shown again, so it needs a fresh render
        if (showSummary && (!string.IsNullOrEmpty(originCountryCode) || targetCountries.Any()))
        {
            worldMapNeedsRender = true;
        }
    }

    private async Task ExpandAllJsonNodes()
    {
        await JSRuntime.InvokeVoidAsync("jsonTreeSetAllCollapsed", "jsonTreeOutput", false);
    }

    private async Task CollapseAllJsonNodes()
    {
        await JSRuntime.InvokeVoidAsync("jsonTreeSetAllCollapsed", "jsonTreeOutput", true);
    }

    /// <summary>
    /// Single search entry point. A URL runs the URL security scan. An IP runs the cloud range
    /// search, plus the reputation check when the IP Rep toggle is on or the input carries ;days.
    /// </summary>
    private async Task SearchAsync()
    {
        if (IsBusy) return;

        if (UrlScanInput.LooksLikeUrl(ipAddress))
        {
            await ScanUrlAsync();
            return;
        }

        if (!IsValidIPAddress(ipAddress))
        {
            statusMessage = UrlScanInput.LooksLikeBareDomain(ipAddress)
                ? $"To scan a website, enter it as a URL, for example https://{ipAddress.Trim()}"
                : "Enter a valid public IPv4/IPv6 address or an http(s) URL (private/reserved ranges are not allowed).";
            return;
        }

        var runReputation = enableReputation || ipAddress.Contains(';');
        cloudSearchSummary = null;
        reputationSummary = null;
        urlScanResult = null;
        if (!runReputation)
        {
            // Clear any reputation results from a previous search so they are not mistaken for this IP's
            abuseIpResult = null;
            formattedJson = string.Empty;
            originCountryCode = null;
            originCountryName = null;
            targetCountries = new();
            attackCategories = new();
            await JSRuntime.InvokeVoidAsync("AlbatrossWorldMap.destroy");
        }

        // Cloud range search and reputation check run side by side
        await Task.WhenAll(ValidateAndSearch(), runReputation ? CheckAbuseIPDBAsync() : Task.CompletedTask);

        statusMessage = string.Join(" ", new[] { cloudSearchSummary, reputationSummary }.Where(m => !string.IsNullOrEmpty(m)));
        StateHasChanged();
    }

    private string? cloudSearchSummary;
    private string? reputationSummary;

    // Enter key runs the same search as the Search button
    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    /// <summary>
    /// Runs a URL security scan through the worker and renders the results
    /// </summary>
    private async Task ScanUrlAsync()
    {
        if (!UrlScanInput.TryValidate(ipAddress, out var normalizedUrl, out var validationError))
        {
            statusMessage = validationError;
            return;
        }

        isScanningUrl = true;
        statusMessage = $"Scanning {normalizedUrl}...";
        urlScanResult = null;
        showScreenshotViewer = false;
        cookieFilter = "All";
        showAllCookies = false;
        showAllOffDomains = false;
        showAllOffDomainScripts = false;
        ClearIpResults();
        formattedJson = string.Empty;
        await JSRuntime.InvokeVoidAsync("AlbatrossWorldMap.destroy");
        StateHasChanged();

        try
        {
            urlScanResult = await AbuseIPDBService.ScanUrlAsync(normalizedUrl, enableAI);
            formattedJson = BuildUrlScanJsonForDisplay(urlScanResult.RawJson);

            var counts = urlScanResult.Response.Summary?.FindingCounts;
            var total = counts?.Values.Sum() ?? 0;
            statusMessage = urlScanResult.Response.ScanBlocked?.Blocked == true
                ? $"URL scan completed, but {urlScanResult.Response.ScanBlocked.Provider} {(urlScanResult.Response.ScanBlocked.Kind == "challenge" ? "challenged" : "blocked")} the scanner. See the warning below."
                : $"URL scan completed: {total} finding(s), risk level {urlScanResult.Response.Summary?.RiskLevel ?? "unknown"}.";
            jsonTreeNeedsRender = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "URL scan error: " + ex.Message);
            statusMessage = $"Error scanning URL: {ex.Message}";
        }
        finally
        {
            isScanningUrl = false;
            StateHasChanged();
        }
    }

    // Pretty-print the scan JSON for the tree viewer, replacing the (large) base64 screenshot with a placeholder
    private static string BuildUrlScanJsonForDisplay(string rawJson)
    {
        try
        {
            var node = JsonNode.Parse(rawJson);
            if (node?["screenshot"]?["image"] is JsonValue image && image.TryGetValue<string>(out var dataUrl))
            {
                node["screenshot"]!["image"] = $"[data:image/jpeg;base64 omitted - {dataUrl.Length / 1024} KB, shown above]";
            }
            return node?.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) ?? rawJson;
        }
        catch (JsonException)
        {
            return rawJson;
        }
    }

    private List<Albatross.Services.UrlScanCookie> FilterCookies(List<Albatross.Services.UrlScanCookie> items) => cookieFilter switch
    {
        "First-party" => items.Where(c => !c.ThirdParty).ToList(),
        "Third-party" => items.Where(c => c.ThirdParty).ToList(),
        "Tracking" => items.Where(c => c.Category is "Analytics" or "Marketing").ToList(),
        "With issues" => items.Where(c => c.Issues?.Any() == true).ToList(),
        _ => items
    };

    private static string CmsStatusText(string? status) => status switch
    {
        "latest" => "Latest",
        "supported" => "Supported",
        "outdated" => "Outdated",
        "insecure" => "Insecure",
        "end-of-life" => "End of life",
        "vendor-managed" => "Vendor managed",
        _ => "Unknown"
    };

    private static string CmsStatusClass(string? status) => status switch
    {
        "latest" or "supported" or "vendor-managed" => "chip-good",
        "outdated" => "chip-warn",
        "insecure" or "end-of-life" => "chip-bad",
