                            {
                                matchedServices.Add(match);
                            }
                        }
                    }
                }
            }
            
            // Search IPv6 prefixes
            if (awsData?.ipv6_prefixes != null)
            {
                foreach (var prefix in awsData.ipv6_prefixes)
