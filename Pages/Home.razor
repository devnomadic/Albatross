    private static string GetTrustGaugeGradient(int score)
    {
        double clamped = Math.Clamp(score, 0, 100);
        double angle = clamped / 100.0 * 180.0;
        string color = GetTrustGaugeColor(score);
        string angleStr = angle.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        return $"conic-gradient(from -90deg, {color} 0deg {angleStr}deg, #3a3f4a {angleStr}deg 180deg, transparent 180deg 360deg)";
    }

    private string GetCategoryPieGradient()
    {
        var total = attackCategories.Sum(c => c.Count);
        if (total == 0)
        {
            return "#3a3f4a 0deg 360deg";
        }

        var segments = new List<string>();
        double cumulative = 0;
        for (int i = 0; i < attackCategories.Count; i++)
        {
            double start = cumulative / total * 360;
            cumulative += attackCategories[i].Count;
            double end = cumulative / total * 360;
            segments.Add($"{GetCategoryColor(i)} {start.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}deg {end.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}deg");
        }

        return string.Join(", ", segments);
    }

