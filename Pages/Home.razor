@{
    var currentMonth = DateTime.Now.Month;
    var logoPath = currentMonth switch
    {
        10 => "/images/ascii-text-art-halloween.png",
        12 => "/images/ascii-text-art-christmas.png",
        _ => "/images/ascii-text-art.png"
    };
}
<img src="@logoPath" alt="CloudIPSearch" width="38%" style="padding-bottom: 5px;" border="0" class="header-ascii-logo"/> <br>
<img src="/images/ascii-text-art-albatross.png" alt="ascii-text-art-albatross" width="15%" border="0" class="header-ascii-logo" /> <br><br>
<div class="ascii-art-pixel-matrix" role="img" aria-label="ASCII art pixel matrix">
    <div class="pixel-matrix__grid">
@foreach (var row in AsciiArtPixelMatrix)
{
    foreach (var shade in row)
    {
        <span class="pixel-matrix__pixel @GetPixelShadeClass(shade)"></span>
    }
}
    </div>
</div>
<br><br>

<input @bind="ipAddress" @bind:event="oninput" @onkeydown="OnInputKeyDown" type="text" inputmode="url" autocomplete="off" spellcheck="false" maxlength="2048"
       placeholder="Enter a public IPv4/IPv6 address (ip;maxDays) or URL (http(s):)" class="ip-input form-control" />
<button class="btn btn-primary" @onclick="SearchAsync" disabled="@IsBusy" title="Search: an IP address checks cloud ranges (plus reputation when enabled); a URL runs a security scan">
    <span class="oi oi-magnifying-glass"></span> Search
</button>
<button class="btn @(enableReputation ? "btn-warning" : "btn-secondary")" @onclick="ToggleReputationAsync" style="margin-left: 10px;" aria-pressed="@(enableReputation ? "true" : "false")"
        title="@(enableReputation ? "IP reputation check enabled (AbuseIPDB, ASN and abuse reports)" : "IP reputation check disabled: IP searches only match cloud ranges")">
    <span class="oi oi-@(enableReputation ? "shield" : "ban")"></span> IP Rep @(enableReputation ? "On" : "Off")
</button>
<button class="btn btn-info" @onclick="ToggleDescription" style="margin-left: 10px;">
    <span class="oi oi-info"></span> About
</button>
<button class="btn @(enableAI ? "btn-success" : "btn-secondary")" @onclick="ToggleAIAsync" style="margin-left: 10px;" aria-pressed="@(enableAI ? "true" : "false")" title="@(enableAI ? "AI Analysis Enabled" : "AI Analysis Disabled")">
    <span class="oi oi-@(enableAI ? "lightbulb" : "ban")"></span> AI @(enableAI ? "On" : "Off")
</button>
<div class="search-mode-hint" aria-live="polite">@SearchModeHint</div>
<br><br>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p class="text-center" style="max-width: 600px; margin: 10px auto; font-weight: 500;">
        @statusMessage
    </p>
}

@if (showDescription)
{    <div class="description-panel">
        <div class="card">            
            <div class="card-header d-flex justify-content-between align-items-center" style="padding: 0.25rem 1rem !important; min-height: 32px !important; height: 32px !important; max-height: 32px !important; box-sizing: border-box !important; overflow: hidden !important;">
                <h5 style="margin: 0 !important; padding: 0 !important; font-size: 0.9rem !important; line-height: 1.1 !important; font-weight: 500 !important;">About Albatross IP Analysis</h5>
                <button class="btn btn-sm btn-close" @onclick="ToggleDescription" style="font-size: 0.75rem !important; padding: 0.125rem 0.25rem !important; margin: 0 !important; height: 24px !important; width: 24px !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important;"></button>            </div>              
            <div class="card-body">
                <p><strong>Albatross</strong> provides comprehensive IP address analysis combining cloud provider identification with security reputation checking.</p>
                
                <h6>🔍 <strong>IP Analysis Features:</strong></h6>
                <ul>
                    <li><strong>Cloud Detection:</strong> Identifies if IPs belong to AWS, Azure, GCP, or Oracle Cloud</li>
                    <li><strong>Abuse Checking:</strong> Queries AbuseIPDB for security reputation and threat intelligence</li>
                    <li><strong>Network Information:</strong> Provides ASN details and network ownership via Cloudflare Radar</li>
                    <li><strong>AI-Powered Analysis:</strong> Uses Cloudflare Workers AI (Llama 3.1 70B) to generate risk assessments and actionable recommendations</li>
                </ul>

                <h6>📝 <strong>Input Formats:</strong></h6>
                <ul>
                    <li><code>8.8.8.8</code> - Standard IP lookup (30 days of abuse reports)</li>
                    <li><code>8.8.8.8;60</code> - Custom report age (60 days of history)</li>
                    <li><code>2001:4860:4860::8888</code> - IPv6 addresses supported</li>
                    <li><code>https://example.com/login</code> - URL security scan</li>
                </ul>

                <h6>🌐 <strong>URL Scanning:</strong></h6>
                <p>Enter a full <code>http://</code> or <code>https://</code> URL. It is sent to the worker base64url-encoded, and the worker runs a passive scan: redirect chain, HTTP/1.1, HTTP/2 and HTTP/3 support, TLS 1.0-1.3 support and certificate details, domain registration age (RDAP), DNS (SPF, DMARC, CAA, DNSSEC), hosting IPs and ASNs, CDN detection, frameworks and libraries with known-vulnerable versions flagged, security headers and cookie flags, and a screenshot of the rendered page. Private, loopback and internal targets are blocked.</p>

                <h6>🤖 <strong>AI Reputation Analysis:</strong></h6>
                <p>Automatically analyzes IP reputation data using Cloudflare Workers AI with Llama 3.1 70B Instruct model. Provides risk level assessment (low/medium/high/critical), trust score (0-100), summary of abuse event patterns, and security recommendations based on real-time threat intelligence.</p>

                <h6>🔒 <strong>Security:</strong></h6>
                <p>All requests use HMAC-SHA256 authentication with timestamp validation. Only public routable IP addresses are accepted (private networks like 10.x.x.x, 192.168.x.x, and 127.x.x.x are blocked).</p>

                <h6>🔌 <strong>API Access:</strong></h6>
                <p>Programmatic access available via REST API with OpenAPI specification. Visit the <a href="/api" style="color: #0d6efd; text-decoration: none; font-weight: 500;">API Documentation</a> for interactive documentation, code examples, and OpenAPI spec download.</p>

                <p><small class="text-muted">Data provided by AbuseIPDB, Cloudflare Radar, Cloudflare Workers AI, and official cloud provider IP manifests.</small></p>
            </div>
        </div>
    </div>
}

<!-- Fixed container for search results to prevent layout shifting -->
<div class="search-results-container @(HasSearchResults() || abuseIpResult != null || urlScanResult != null ? "has-results" : "") @(isSearching || isCheckingAbuse || isScanningUrl ? "searching" : "")">    @if (isSearching && !isCheckingAbuse)
    {
        <div class="spinner-container">
            <div class="loading-bars">
                <div class="bar1"></div>
                <div class="bar2"></div>
                <div class="bar3"></div>
                <div class="bar4"></div>
                <div class="bar5"></div>
            </div>
            <small class="text-muted">Searching cloud IP ranges...</small>
        </div>
    }
    else if (!isSearching)
    {
        @if (azureMatchedServices != null && azureMatchedServices.Any())
        {
            <div class="results">
                <h3>Matching Azure Services:</h3>
                <div>
                    @foreach (var service in azureMatchedServices)
                    {
                        <div class="service-match">
                            <strong>@service.ServiceInfo</strong>
                            <br />
                            <small class="text-muted">CIDR Range: @service.CidrRange</small>
                        </div>
                    }
                </div>
            </div>
        }

        @if (awsMatchedServices != null && awsMatchedServices.Any())
        {
            <div class="results">
                <h3>Matching AWS Services:</h3>
                <div>
                    @foreach (var service in awsMatchedServices)
                    {
                        <div class="service-match">
                            <strong>@service.ServiceInfo</strong>
                            <br />
                            <small class="text-muted">CIDR Range: @service.CidrRange</small>
                        </div>
                    }
                </div>
            </div>
        }

        @if (gcpMatchedServices != null && gcpMatchedServices.Any())
        {
            <div class="results">
                <h3>Matching GCP Services:</h3>
                <div>
                    @foreach (var service in gcpMatchedServices)
                    {
                        <div class="service-match">
                            <strong>@service.ServiceInfo</strong>
                            <br />
                            <small class="text-muted">CIDR Range: @service.CidrRange</small>
                        </div>
                    }
                </div>
            </div>
        }

        @if (oracleMatchedServices != null && oracleMatchedServices.Any())
        {
            <div class="results">
                <h3>Matching Oracle Cloud Services:</h3>
                <div>
                    @foreach (var service in oracleMatchedServices)
                    {
                        <div class="service-match">
                            <strong>@service.ServiceInfo</strong>
                            <br />
                            <small class="text-muted">CIDR Range: @service.CidrRange</small>
                        </div>
                    }
                </div>
            </div>
        }
    }    @if (isCheckingAbuse)
    {
        <div class="spinner-container">
            <div class="loading-bars abuse-check">
                <div class="bar1"></div>
                <div class="bar2"></div>
                <div class="bar3"></div>
                <div class="bar4"></div>
                <div class="bar5"></div>
            </div>
            <small class="text-muted">Checking IP reputation...</small>
        </div>
    }@if (abuseIpResult != null)
    {
        <center>
        <div class="results card-container">
            <h3>IP Reputation Results for @(abuseIpResult.Data?.IpAddress ?? ipAddress)</h3>
            @if (showSummary && (!string.IsNullOrEmpty(originCountryCode) || targetCountries.Any()))
            {
                <div class="world-map-section mb-3 text-center">
                    <h5 class="world-map-title">🌍 Threat Map: Origin &amp; Reporter Locations</h5>
                    <div id="abuse-world-map" class="world-map-container mx-auto"></div>
                    <div class="world-map-legend mt-3">
                        <span><span class="legend-swatch legend-origin"></span>Reported abuser origin@(string.IsNullOrEmpty(originCountryName) ? "" : $": {originCountryName} ({originCountryCode})")</span>
                        <span><span class="legend-swatch legend-target"></span>Reporter countries (darker = more reports filed)</span>
                    </div>
                    @if (targetCountries.Any())
                    {
                        <ul class="target-country-list mt-2 mb-0 list-unstyled d-inline-block text-start">
                            @foreach (var t in targetCountries.Take(10))
                            {
                                <li>@t.Name (@t.Code): @t.Count report@(t.Count == 1 ? "" : "s") filed</li>
                            }
                        </ul>
                    }
                </div>
                @if (attackCategories.Any() || TrustScore.HasValue)
                {
                    <div class="analytics-row mt-3">
                        @if (attackCategories.Any())
                        {
                            <div class="category-pie-section">
                                <h6 class="world-map-title" style="font-size:0.85rem;">📊 Reported Attack Category Mix</h6>
                                <div class="category-pie-wrapper">
                                    <div class="category-pie-chart" style="background: conic-gradient(@GetCategoryPieGradient());"></div>
                                    <ul class="category-pie-legend list-unstyled mb-0 text-start">
                                        @{ var totalCategoryReports = attackCategories.Sum(c => c.Count); }
                                        @foreach (var (cat, idx) in attackCategories.Select((c, i) => (c, i)))
                                        {
                                            <li><span class="legend-swatch legend-round" style="background-color:@GetCategoryColor(idx);"></span>@cat.Name: @cat.Count (@((cat.Count * 100.0 / totalCategoryReports).ToString("0.#"))%)</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (TrustScore.HasValue)
                        {
                            <div class="trust-gauge-section">
                                <h6 class="world-map-title" style="font-size:0.85rem;">🛡️ AI Trust Score</h6>
                                <div class="trust-gauge-wrapper">
                                    <div class="trust-gauge-arc" style="background: @GetTrustGaugeGradient(TrustScore.Value);"></div>
                                    <div class="trust-gauge-center">
                                        <span class="trust-gauge-value">@TrustScore</span><span class="trust-gauge-max">/100</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(abuseIpResult?.AIReputation?.Analysis?.RiskLevel))
                                {
                                    <div class="trust-gauge-risklabel" style="color:@GetTrustGaugeColor(TrustScore.Value);">@abuseIpResult!.AIReputation!.Analysis!.RiskLevel!.ToUpperInvariant() RISK</div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            @JsonCard("AbuseIPDB JSON Response")
        </div>
        </center>
    }

    @if (isScanningUrl)
    {
        <div class="spinner-container">
            <div class="loading-bars abuse-check">
                <div class="bar1"></div>
                <div class="bar2"></div>
                <div class="bar3"></div>
                <div class="bar4"></div>
                <div class="bar5"></div>
            </div>
            <small class="text-muted">Scanning URL (DNS, TLS, redirects, technologies, screenshot)... this can take up to 30 seconds</small>
        </div>
    }

    @if (urlScanResult != null)
    {
        var scan = urlScanResult.Response;
        <center>
        <div class="results card-container">
            <h3 class="url-scan-heading">URL Scan Results for <span class="url-scan-target">@(scan.Summary?.FinalUrl ?? scan.Target?.Url)</span></h3>
            @if (scan.ScanBlocked?.Blocked == true)
            {
                <div class="url-scan-blocked" role="alert">
                    <div class="url-scan-blocked-title">🛑 @(scan.ScanBlocked.Kind == "challenge" ? "Bot challenge" : scan.ScanBlocked.Kind == "rate-limit" ? "Rate limited" : "Scan blocked") by @scan.ScanBlocked.Provider</div>
                    <div>@scan.ScanBlocked.Message</div>
                    @if (scan.ScanBlocked.Evidence?.Any() == true)
                    {
                        <div class="url-scan-muted mt-1">Evidence: @string.Join(" · ", scan.ScanBlocked.Evidence)</div>
                    }
                </div>
            }
            @if (showSummary)
            {
                <div class="url-scan">
                    <div class="url-scan-top">
                        <div class="url-scan-card url-scan-screenshot">
                            <div class="url-scan-card-title">📸 Screenshot</div>
                            @if (scan.Screenshot?.Success == true && !string.IsNullOrEmpty(scan.Screenshot.Image))
                            {
                                <button type="button" class="screenshot-thumb" @onclick="() => showScreenshotViewer = true" title="View full-size screenshot">
                                    <img src="@scan.Screenshot.Image" alt="Screenshot of @(scan.Summary?.FinalUrl)" loading="lazy" />
                                    <span class="screenshot-zoom-hint">🔍 Click to enlarge</span>
                                </button>
                                <div class="url-scan-muted">Rendered at @(scan.Screenshot.Width)×@(scan.Screenshot.Height) · @(scan.Screenshot.RequestCount ?? 0) network requests@(string.IsNullOrEmpty(scan.Screenshot.NavigationWarning) ? "" : " · page did not fully settle")</div>
                                <div class="screenshot-actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary json-toggle-btn" @onclick="() => showScreenshotViewer = true">⤢ View full size</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary json-toggle-btn" @onclick="() => OpenScreenshotInNewTab(scan.Screenshot.Image)">↗ Open in new tab</button>
                                    <a class="btn btn-sm btn-outline-secondary json-toggle-btn" href="@scan.Screenshot.Image" download="@ScreenshotFileName(scan)">⬇ Download</a>
                                </div>
                                @if (showScreenshotViewer)
                                {
                                    <div class="screenshot-lightbox" role="dialog" aria-modal="true" aria-label="Full-size screenshot" @onclick="() => showScreenshotViewer = false">
                                        <div class="screenshot-lightbox-bar">
                                            <span>@(scan.Screenshot.FinalUrl ?? scan.Summary?.FinalUrl)</span>
                                            <button type="button" class="btn btn-sm btn-light" @onclick="() => showScreenshotViewer = false" aria-label="Close">✕ Close</button>
                                        </div>
                                        <img src="@scan.Screenshot.Image" alt="Full-size screenshot of @(scan.Summary?.FinalUrl)" @onclick:stopPropagation="true" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="url-scan-placeholder">@(scan.Screenshot?.Error ?? "No screenshot available")</div>
                            }
                        </div>

                        <div class="url-scan-card url-scan-overview">
                            <div class="url-scan-card-title">🛡️ Security Overview</div>
                            @if (scan.Summary?.SecurityScore is int score)
                            {
                                <div class="trust-gauge-section url-scan-gauge">
                                    <div class="trust-gauge-wrapper">
                                        <div class="trust-gauge-arc" style="background: @GetTrustGaugeGradient(score);"></div>
                                        <div class="trust-gauge-center">
                                            <span class="trust-gauge-value">@score</span><span class="trust-gauge-max">/100</span>
                                        </div>
                                    </div>
                                    <div class="trust-gauge-risklabel" style="color:@GetTrustGaugeColor(score);">@((scan.Summary.RiskLevel ?? "unknown").ToUpperInvariant()) RISK</div>
                                </div>
                            }
                            @if (scan.Summary?.SecurityScore is null && !string.IsNullOrEmpty(scan.Summary?.ScoreNote))
                            {
                                <div class="url-scan-placeholder" style="min-height:80px;margin-bottom:0.75rem;">@scan.Summary.ScoreNote</div>
                            }
                            <div class="url-scan-counts">
                                @foreach (var sev in SeverityOrder)
                                {
                                    var count = scan.Summary?.FindingCounts != null && scan.Summary.FindingCounts.TryGetValue(sev, out var c) ? c : 0;
                                    <span class="sev-badge sev-@sev @(count == 0 ? "sev-zero" : "")">@count @sev</span>
                                }
                            </div>
                            <dl class="url-scan-kv">
                                <dt>Status</dt><dd>@(scan.Summary?.StatusCode?.ToString() ?? "n/a") @(scan.Summary?.FetchError)</dd>
                                <dt>Title</dt><dd>@(scan.Summary?.Title ?? "n/a")</dd>
                                <dt>Input</dt><dd>@(scan.Input?.Encoding) → @(scan.Input?.Url)</dd>
                                <dt>Scan time</dt><dd>@(scan.Summary?.DurationMs is long ms ? $"{ms / 1000.0:0.0}s" : "n/a")</dd>
                            </dl>
                            @if (scan.AiAssessment?.Success == true && scan.AiAssessment.Analysis != null)
                            {
                                var ai = scan.AiAssessment.Analysis;
                                <div class="url-scan-ai">
                                    <div class="url-scan-subtitle">🤖 AI Assessment @(UrlScanAiAnalysis.AsText(ai.PhishingLikelihood) is string ph ? $"· phishing likelihood: {ph}" : "")</div>
                                    <p>@UrlScanAiAnalysis.AsText(ai.Summary)</p>
                                    @{ var risks = UrlScanAiAnalysis.AsList(ai.KeyRisks); var recs = UrlScanAiAnalysis.AsList(ai.Recommendations); }
                                    @if (risks.Any())
                                    {
                                        <div class="url-scan-muted">Key risks</div>
                                        <ul>@foreach (var r in risks) { <li>@r</li> }</ul>
                                    }
                                    @if (recs.Any())
                                    {
                                        <div class="url-scan-muted">Recommendations</div>
                                        <ul>@foreach (var r in recs) { <li>@r</li> }</ul>
                                    }
                                </div>
                            }
                            else if (enableAI && !string.IsNullOrEmpty(scan.AiAssessment?.Error))
                            {
                                <div class="url-scan-muted">AI assessment unavailable: @scan.AiAssessment!.Error</div>
                            }
                        </div>
                    </div>

                    <div class="url-scan-grid">
                        <div class="url-scan-card">
                            <div class="url-scan-card-title">🔐 Connection &amp; TLS</div>
                            <div class="url-scan-subtitle">HTTP versions</div>
                            <div class="chip-row">
                                @foreach (var v in scan.Http?.Versions ?? new Dictionary<string, bool?>())
                                {
                                    <span class="chip @(v.Value == true ? "chip-good" : v.Value == false ? "chip-off" : "chip-unknown")" title="@(v.Value == null ? "Not determined" : v.Value == true ? "Supported" : "Not supported")">@FormatHttpVersion(v.Key)</span>
                                }
                            </div>
                            <div class="url-scan-subtitle">TLS versions</div>
                            @if (scan.Tls?.Probed == true && scan.Tls.Versions != null)
                            {
                                <div class="chip-row">
                                    @foreach (var key in new[] { "tls1_3", "tls1_2", "tls1_1", "tls1_0" })
                                    {
                                        var supported = scan.Tls.Versions.TryGetValue(key, out var sup) && sup;
                                        var legacy = key is "tls1_0" or "tls1_1";
                                        <span class="chip @(supported ? (legacy ? "chip-bad" : "chip-good") : "chip-off")">@FormatTlsVersion(key) @(supported ? "✓" : "✗")</span>
                                    }
                                </div>
                                <dl class="url-scan-kv">
                                    <dt>Cipher</dt><dd>@(scan.Tls.PreferredCipher ?? "n/a")</dd>
                                    @if (!string.IsNullOrEmpty(scan.Tls.Alpn)) { <dt>ALPN</dt><dd>@scan.Tls.Alpn</dd> }
                                </dl>
                            }
                            else
                            {
                                <div class="url-scan-muted url-scan-note">@(scan.Tls?.BehindCloudflare == true ? "☁️ " : "ℹ️ ")@(scan.Tls?.Error ?? "TLS not probed")</div>
                            }
                            <dl class="url-scan-kv">
                                <dt>HTTP→HTTPS</dt>
                                <dd>@(scan.Http?.HttpsEnforcement?.Checked == true ? (scan.Http.HttpsEnforcement.Enforced == true ? "✓ redirected" : $"✗ not enforced ({scan.Http.HttpsEnforcement.StatusCode})") : "not checked")</dd>
                            </dl>
                        </div>

                        <div class="url-scan-card">
                            <div class="url-scan-card-title">📜 Certificate</div>
                            @if (scan.Tls?.Certificate is { Error: null } cert)
                            {
                                <dl class="url-scan-kv">
                                    <dt>Subject</dt><dd>@(cert.Subject?.GetValueOrDefault("CN") ?? cert.SubjectString)</dd>
                                    <dt>Issuer</dt><dd>@(cert.Issuer?.GetValueOrDefault("O") ?? cert.IssuerFriendlyName ?? cert.Issuer?.GetValueOrDefault("CN") ?? cert.IssuerString)@(cert.Issuer?.GetValueOrDefault("CN") is string icn ? $" ({icn})" : "")</dd>
                                    <dt>Valid to</dt><dd class="@(cert.Expired || cert.DaysRemaining < 14 ? "text-danger" : "")">@FormatDate(cert.ValidTo) (@(cert.Expired ? "expired" : $"{cert.DaysRemaining} days left"))</dd>
                                    <dt>Key</dt><dd>@cert.KeyAlgorithm @(cert.KeySize.HasValue ? $"{cert.KeySize}-bit" : "")</dd>
                                    <dt>Signature</dt><dd>@cert.SignatureAlgorithm</dd>
                                    <dt>Hostname</dt><dd>@(cert.HostnameMatch == true ? "✓ matches" : cert.HostnameMatch == false ? "✗ mismatch" : "n/a")@(cert.SelfSigned ? " · self-signed" : "")</dd>
                                    @if (cert.ChainLength.HasValue) { <dt>Chain</dt><dd>@cert.ChainLength certificate(s)</dd> }
                                    <dt>Source</dt><dd>@(cert.Source == "certificate-transparency" ? "Certificate Transparency logs" : "Live TLS handshake")</dd>
                                    @if (cert.SubjectAltNames?.Any() == true)
                                    {
                                        <dt>SANs</dt><dd>@string.Join(", ", cert.SubjectAltNames.Take(6))@(cert.SubjectAltNames.Count > 6 ? $" +{cert.SubjectAltNames.Count - 6} more" : "")</dd>
                                    }
                                </dl>
                                @if (!string.IsNullOrEmpty(scan.Tls?.CertificateNote))
                                {
                                    <div class="url-scan-muted url-scan-note">ℹ️ @scan.Tls!.CertificateNote</div>
                                }
                            }
                            else
                            {
                                <div class="url-scan-muted">@(scan.Tls?.Certificate?.Error ?? scan.Tls?.CertificateNote ?? "No certificate information could be retrieved for this host.")</div>
                            }
                        </div>

                        <div class="url-scan-card">
                            <div class="url-scan-card-title">🏷️ Domain</div>
                            @{ var reg = scan.Domain?.Registration; var dns = scan.Domain?.Dns; }
                            <dl class="url-scan-kv">
                                <dt>Domain</dt><dd>@(scan.Domain?.Name ?? scan.Target?.Hostname)</dd>
                                @if (reg?.Success == true)
                                {
                                    <dt>Registered</dt>
                                    <dd class="@(reg.AgeDays < 180 ? "text-danger" : "")">@(reg.Created != null ? $"{FormatDate(reg.Created)} ({FormatAge(reg.AgeDays)})" : reg.RegistrationDateRedacted ? "Not published by registry" : "n/a")</dd>
                                    <dt>Expires</dt><dd>@(reg.Expires != null ? FormatDate(reg.Expires) : reg.ExpirationDateRedacted ? "Not published by registry" : "n/a")</dd>
                                    @if (reg.Created == null && reg.Updated != null) { <dt>Last changed</dt><dd>@FormatDate(reg.Updated)</dd> }
                                    <dt>Registrar</dt><dd>@(reg.Registrar ?? "n/a")</dd>
                                    <dt>Source</dt><dd title="@reg.Source">@(reg.Method == "whois" ? "WHOIS" : "RDAP") · @(Uri.TryCreate(reg.Source, UriKind.Absolute, out var regSrc) ? regSrc.Host : reg.Source)</dd>
                                }
                                else
                                {
                                    <dt>Registration</dt><dd>@(reg?.Error ?? "n/a")</dd>
                                }
                                @if (dns != null && !dns.Skipped)
                                {
                                    <dt>DNSSEC</dt><dd>@(dns.Dnssec == true ? "✓ validated" : "✗ not validated")</dd>
                                    <dt>SPF</dt><dd>@(string.IsNullOrEmpty(dns.Spf) ? "✗ none" : "✓ " + Truncate(dns.Spf, 60))</dd>
                                    <dt>DMARC</dt><dd>@(string.IsNullOrEmpty(dns.Dmarc) ? "✗ none" : "✓ " + Truncate(dns.Dmarc, 60))</dd>
                                    <dt>CAA</dt><dd>@(dns.Caa?.Any() == true ? string.Join(", ", dns.Caa.Take(3)) : "none")</dd>
                                    @if (dns.Cname?.Any() == true) { <dt>CNAME</dt><dd>@string.Join(" → ", dns.Cname)</dd> }
                                }
                            </dl>
                            @if (!string.IsNullOrEmpty(reg?.Note))
                            {
                                <div class="url-scan-muted url-scan-note">ℹ️ @reg!.Note</div>
                            }
                        </div>

                        <div class="url-scan-card">
                            <div class="url-scan-card-title">🌍 Hosting &amp; CDN</div>
                            <div class="chip-row">
                                @if (scan.Network?.Cdn?.Detected == true)
                                {
                                    @foreach (var p in scan.Network.Cdn.Providers ?? new())
                                    {
                                        <span class="chip chip-info" title="@string.Join("\n", p.Evidence ?? new())">@p.Name</span>
                                    }
                                    @if (!string.IsNullOrEmpty(scan.Network.Cdn.CacheStatus)) { <span class="chip chip-unknown" title="From the @scan.Network.Cdn.CacheHeader response header">cache: @scan.Network.Cdn.CacheStatus</span> }
                                }
                                else
                                {
                                    <span class="chip chip-unknown">No CDN detected</span>
                                }
                            </div>
                            <table class="url-scan-table">
                                <thead><tr><th>IP</th><th>ASN</th><th>Abuse</th></tr></thead>
                                <tbody>
                                    @foreach (var ip in scan.Network?.Ips ?? new())
                                    {
                                        <tr>
                                            <td><code>@ip.Ip</code>@(string.IsNullOrEmpty(ip.Country) ? "" : $" ({ip.Country})")</td>
                                            <td>@(ip.Asn.HasValue ? $"AS{ip.Asn} {ip.AsnName}" : ip.Isp ?? "n/a")</td>
                                            <td>@(ip.AbuseConfidenceScore.HasValue ? $"{ip.AbuseConfidenceScore}%" : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="url-scan-card">
                            <div class="url-scan-card-title">↪️ Redirect Chain (@(scan.Redirects?.Count ?? 0) hop@((scan.Redirects?.Count ?? 0) == 1 ? "" : "s"))</div>
                            <ol class="url-scan-redirects">
                                @foreach (var hop in scan.Redirects?.Chain ?? new())
                                {
                                    <li>
                                        <span class="chip @(hop.StatusCode >= 400 ? "chip-bad" : hop.StatusCode >= 300 ? "chip-info" : "chip-good")">@hop.StatusCode</span>
                                        <span class="url-scan-url">@hop.Url</span>
                                        @if (hop.HttpsDowngrade == true) { <span class="chip chip-bad">HTTPS→HTTP</span> }
                                        @if (hop.CrossDomain == true) { <span class="chip chip-warn">cross-domain</span> }
                                    </li>
                                }
                            </ol>
                            @if (!string.IsNullOrEmpty(scan.Redirects?.Error)) { <div class="text-danger small">@scan.Redirects!.Error</div> }
                        </div>

                        <div class="url-scan-card">
                            <div class="url-scan-card-title">🧾 Security Headers</div>
                            <table class="url-scan-table">
                                <tbody>
                                    @foreach (var h in scan.Http?.SecurityHeaders ?? new())
                                    {
                                        <tr title="@(h.Value ?? h.Note)">
                                            <td>@h.Name</td>
                                            <td><span class="chip @HeaderStatusClass(h.Status)">@h.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="url-scan-card url-scan-wide">
                        <div class="url-scan-card-title">📰 CMS / Platform</div>
                        @if (scan.Cms?.Detected == true)
                        {
                            <table class="url-scan-table">
                                <thead><tr><th>Platform</th><th>Type</th><th>Detected via</th><th>Version</th><th>How the version was found</th><th>Support status</th><th>Latest</th></tr></thead>
                                <tbody>
                                    @foreach (var p in scan.Cms.Platforms ?? new())
                                    {
                                        <tr class="@(p.Support?.Status is "insecure" or "end-of-life" ? "row-vuln" : "")">
                                            <td title="@string.Join("\n", p.Evidence ?? new())"><strong>@p.Name</strong></td>
                                            <td>@p.Type</td>
                                            <td title="@string.Join("\n", p.Evidence ?? new())">
                                                <span class="chip @(p.Confidence == "high" ? "chip-good" : p.Confidence == "medium" ? "chip-info" : "chip-warn")">@(p.Confidence ?? "high") confidence</span>
                                                <span class="url-scan-muted">@string.Join(", ", (p.DetectedVia ?? new()).Select(v => v == "keyword" ? "HTML keywords" : v))</span>
                                            </td>
                                            <td>@(p.Version ?? "unknown")</td>
                                            <td class="url-scan-muted">@(p.VersionSource ?? "not exposed")</td>
                                            <td><span class="chip @CmsStatusClass(p.Support?.Status)" title="@p.Support?.Source">@CmsStatusText(p.Support?.Status)</span> <span class="url-scan-muted">@p.Support?.Label</span></td>
                                            <td>@(p.Support?.Latest ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (scan.Cms.Platforms?.Any(p => p.Confidence is "low" or "medium") == true)
                            {
                                <div class="url-scan-muted">Platforms marked low or medium confidence were found only by HTML keywords, such as a "Powered by" credit in the footer or a platform's signature comment. Hover a row to see the matched text.</div>
                            }
                            <div class="url-scan-muted url-scan-note">ℹ️ Support status comes from the official release data (api.wordpress.org, updates.drupal.org, downloads.joomla.org), cached for 12 hours. Hosted platforms like Shopify or Wix are patched by the vendor.</div>
                        }
                        else
                        {
                            <div class="url-scan-muted">No content management system or site platform was detected.</div>
                        }
                    </div>

                    <div class="url-scan-card url-scan-wide">
                        <div class="url-scan-card-title">🍪 Cookies (@(scan.Cookies?.Total ?? 0))</div>
                        @if (scan.Cookies is { Total: > 0 } ck)
                        {
                            <div class="chip-row">
                                <span class="chip chip-info">@ck.FirstParty first-party</span>
                                <span class="chip @(ck.ThirdParty > 0 ? "chip-warn" : "chip-unknown")">@ck.ThirdParty third-party</span>
                                <span class="chip chip-unknown">@ck.Session session</span>
                                <span class="chip chip-unknown">@ck.Persistent persistent</span>
                                <span class="chip @(ck.Tracking > 0 ? "chip-warn" : "chip-unknown")">@ck.Tracking tracking</span>
                                <span class="chip @(ck.WithIssues > 0 ? "chip-bad" : "chip-good")">@ck.WithIssues with issues</span>
                            </div>
                            @if (ck.ByCategory?.Any() == true)
                            {
                                <div class="url-scan-subtitle">By purpose</div>
                                <div class="chip-row">
                                    @foreach (var cat in ck.ByCategory.OrderByDescending(c => c.Value))
                                    {
                                        <span class="chip @CookieCategoryClass(cat.Key)">@cat.Key: @cat.Value</span>
                                    }
                                </div>
                            }
                            @if (ck.ThirdPartyDomains?.Any() == true)
                            {
                                <div class="url-scan-muted">Third-party domains: @string.Join(", ", ck.ThirdPartyDomains.Take(15))@(ck.ThirdPartyDomains.Count > 15 ? $" +{ck.ThirdPartyDomains.Count - 15} more" : "")</div>
                            }

                            var filtered = FilterCookies(ck.Items ?? new());
                            <div class="cookie-filters">
                                @foreach (var f in CookieFilters)
                                {
                                    <button type="button" class="btn btn-sm @(cookieFilter == f ? "btn-secondary" : "btn-outline-secondary") json-toggle-btn" @onclick="() => { cookieFilter = f; showAllCookies = false; }">@f</button>
                                }
                            </div>
                            <table class="url-scan-table cookie-table">
                                <thead><tr><th>Name</th><th>Domain</th><th>Purpose</th><th>Expires</th><th>Flags</th><th>Seen via</th><th>Issues</th></tr></thead>
                                <tbody>
                                    @foreach (var c in showAllCookies ? filtered : filtered.Take(CookiePageSize))
                                    {
                                        <tr class="@(c.Issues?.Any() == true ? "row-vuln" : "")">
                                            <td class="cookie-name" title="@c.Name"><code>@c.Name</code></td>
                                            <td title="@($"{c.Domain}{c.Path}")">@c.Domain @if (c.ThirdParty) { <span class="chip chip-warn">3P</span> }</td>
                                            <td><span class="chip @CookieCategoryClass(c.Category)">@c.Category</span>@(string.IsNullOrEmpty(c.Vendor) ? "" : $" {c.Vendor}")</td>
                                            <td title="@c.Expires">@(c.Session ? "Session" : FormatCookieLifetime(c.LifetimeDays))</td>
                                            <td class="cookie-flags">
                                                <span class="chip @(c.Secure ? "chip-good" : "chip-off")" title="Secure">S</span>
                                                <span class="chip @(c.HttpOnly ? "chip-good" : "chip-off")" title="HttpOnly">H</span>
                                                <span class="chip @(c.SameSite is null ? "chip-off" : c.SameSite == "none" ? "chip-warn" : "chip-good")" title="SameSite">@(c.SameSite ?? "SameSite?")</span>
                                            </td>
                                            <td>@string.Join(", ", (c.Sources ?? new()).Select(src => src == "http-header" ? "header" : src))</td>
                                            <td>@string.Join(", ", c.Issues ?? new())</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (filtered.Count > CookiePageSize)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary json-toggle-btn mt-2" @onclick="() => showAllCookies = !showAllCookies">
                                    @(showAllCookies ? "Show fewer" : $"Show all {filtered.Count} cookies")
                                </button>
                            }
                            <div class="url-scan-muted mt-1">
                                Flags: S = Secure, H = HttpOnly. Cookie values are never collected.
                                @(ck.BrowserInspected ? "Includes cookies set by JavaScript and third-party resources during page rendering." : "Only cookies from HTTP response headers are shown, because the page could not be rendered in a browser.")
                                @(ck.Truncated ? $" The list is limited to the first {ck.Items?.Count} cookies." : "")
                            </div>
                        }
                        else
                        {
                            <div class="url-scan-muted">No cookies were set on the first visit@(scan.Cookies?.BrowserInspected == false ? " (HTTP response headers only; the page was not rendered in a browser)" : "").</div>
                        }
                    </div>

                    <div class="url-scan-card url-scan-wide">
                        <div class="url-scan-card-title">🌐 Off-domain Resources</div>
                        @if (scan.OffDomain is { } off)
                        {
                            <div class="chip-row">
                                <span class="chip chip-info">@off.OffDomainRequests of @off.TotalRequests requests off-domain</span>
                                <span class="chip @(off.DomainCount > 0 ? "chip-warn" : "chip-good")">@off.DomainCount third-party domain@(off.DomainCount == 1 ? "" : "s")</span>
                                <span class="chip @(off.ScriptDomainCount > 0 ? "chip-warn" : "chip-good")">scripts from @off.ScriptDomainCount domain@(off.ScriptDomainCount == 1 ? "" : "s") (@off.ThirdPartyScriptCount files)</span>
                                <span class="chip @(off.ScriptsWithoutSri > 0 ? "chip-bad" : "chip-good")">@off.ScriptsWithoutSri without SRI</span>
                                @if (off.InsecureRequests > 0) { <span class="chip chip-bad">@off.InsecureRequests over HTTP</span> }
                                @if (off.FailedRequests > 0) { <span class="chip chip-unknown">@off.FailedRequests failed</span> }
                            </div>
                            @if (off.ByCategory?.Any() == true)
                            {
                                <div class="chip-row">
                                    @foreach (var cat in off.ByCategory.OrderByDescending(c => c.Value))
                                    {
                                        <span class="chip @ResourceCategoryClass(cat.Key)">@cat.Key: @cat.Value</span>
                                    }
                                </div>
                            }
                            @if (off.RelatedDomains?.Any() == true)
                            {
                                <div class="url-scan-muted">Treated as the site's own domains: @string.Join(", ", off.RelatedDomains.Select(r => $"{r.Domain} ({r.Reason})"))</div>
                            }

                            @if (off.Domains?.Any() == true)
                            {
                                <div class="url-scan-subtitle">Domains</div>
                                <table class="url-scan-table">
                                    <thead><tr><th>Domain</th><th>Category</th><th>Requests</th><th>Types</th><th>Size</th><th>IPs</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in showAllOffDomains ? off.Domains : off.Domains.Take(OffDomainPageSize))
                                        {
                                            <tr class="@(d.Insecure > 0 || d.IpLiteral ? "row-vuln" : "")">
                                                <td title="@string.Join("\n", d.Hosts ?? new())"><strong>@d.Domain</strong>@if ((d.Hosts?.Count ?? 0) > 1) { <span class="url-scan-muted"> +@(d.Hosts!.Count - 1) host@(d.Hosts.Count == 2 ? "" : "s")</span> }</td>
                                                <td><span class="chip @ResourceCategoryClass(d.Category)">@d.Category</span>@(string.IsNullOrEmpty(d.Vendor) ? "" : $" {d.Vendor}")</td>
                                                <td>@d.Requests</td>
                                                <td class="resource-types">
                                                    @foreach (var t in (d.Types ?? new()).OrderByDescending(t => t.Value))
                                                    {
                                                        <span class="chip @(t.Key == "script" ? "chip-warn" : "chip-unknown")">@t.Key ×@t.Value</span>
                                                    }
                                                </td>
                                                <td>@FormatBytes(d.Bytes)</td>
                                                <td><code>@string.Join(", ", d.Ips ?? new())</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (off.Domains.Count > OffDomainPageSize)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary json-toggle-btn mt-2" @onclick="() => showAllOffDomains = !showAllOffDomains">@(showAllOffDomains ? "Show fewer" : $"Show all {off.Domains.Count} domains")</button>
                                }
                            }

                            @if (off.Scripts?.Any() == true)
                            {
                                <div class="url-scan-subtitle">Off-domain scripts</div>
                                <table class="url-scan-table">
                                    <thead><tr><th>Script</th><th>Domain</th><th>SRI</th><th>Size</th><th>Library</th><th>Notes</th></tr></thead>
                                    <tbody>
                                        @foreach (var js in showAllOffDomainScripts ? off.Scripts : off.Scripts.Take(OffDomainPageSize))
                                        {
                                            <tr class="@(js.Insecure ? "row-vuln" : "")">
                                                <td class="script-url" title="@js.Url"><code>@js.Url</code></td>
                                                <td>@js.Domain@(js.Related ? " (site-owned)" : "")</td>
                                                <td><span class="chip @(js.Integrity == true ? "chip-good" : js.Integrity == false ? (js.Related ? "chip-unknown" : "chip-bad") : "chip-unknown")" title="@(js.Integrity == null ? "Script was injected by JavaScript, so its integrity attribute could not be read" : "")">@(js.Integrity == true ? "yes" : js.Integrity == false ? "no" : "n/a")</span></td>
                                                <td>@FormatBytes(js.Size ?? 0)</td>
                                                <td>@(js.Library ?? "-")</td>
                                                <td class="url-scan-muted">@string.Join(", ", new[] { js.Injected ? "injected by JS" : null, js.Frame == "sub-frame" ? "in iframe" : null, js.Insecure ? "HTTP" : null, js.Failed != null ? $"failed: {js.Failed}" : null, js.Status >= 400 ? $"HTTP {js.Status}" : null }.Where(x => x != null))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (off.Scripts.Count > OffDomainPageSize)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary json-toggle-btn mt-2" @onclick="() => showAllOffDomainScripts = !showAllOffDomainScripts">@(showAllOffDomainScripts ? "Show fewer" : $"Show all {off.Scripts.Count} scripts")</button>
                                }
                            }
                            @if (off.DomainCount == 0 && off.RelatedDomains?.Any() != true)
                            {
                                <div class="url-scan-muted">The page did not load anything from other domains.</div>
                            }
                            <div class="url-scan-muted url-scan-note">ℹ️ Source: @off.Source. Third-party scripts run with full access to the page, so each script domain is part of the site's supply chain.</div>
                        }
                        else
                        {
                            <div class="url-scan-muted">Off-domain analysis not available.</div>
                        }
                    </div>

                    <div class="url-scan-card url-scan-wide">
                        <div class="url-scan-card-title">🔗 Affiliate Activity</div>
                        @if (scan.Affiliate is { } aff)
                        {
                            <div class="chip-row">
                                <span class="chip @AffiliateVerdictClass(aff.Verdict)">@AffiliateVerdictText(aff.Verdict)</span>
                                @if (!string.IsNullOrEmpty(aff.Confidence)) { <span class="chip chip-unknown">confidence: @aff.Confidence</span> }
                                @foreach (var n in aff.Networks ?? new()) { <span class="chip chip-info">@n</span> }
                            </div>

                            @if (aff.Background?.Any() == true)
                            {
                                <div class="url-scan-subtitle">⚠️ Affiliate click requests fired without any user interaction</div>
                                <table class="url-scan-table">
                                    <thead><tr><th>Network</th><th>Loaded as</th><th>Hidden</th><th>Affiliate ID</th><th>URL</th></tr></thead>
                                    <tbody>
                                        @foreach (var b in aff.Background)
                                        {
                                            <tr class="row-vuln">
                                                <td>@b.Network</td>
                                                <td>@b.ResourceType@(b.Frame == "sub-frame" ? " (in iframe)" : "")</td>
                                                <td>@(b.Hidden ?? "-")</td>
                                                <td>@(b.AffiliateId ?? "-")</td>
                                                <td class="url-scan-url"><code>@b.Url</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="url-scan-muted mt-1">The scanner never clicks anything. Affiliate click URLs loaded in the background drop commission cookies on visitors who never chose to follow an affiliate link, which is the signature of cookie stuffing.</div>
                            }

                            @if (aff.Navigation?.Any() == true)
                            {
                                <div class="url-scan-subtitle">Affiliate link in the scanned URL's redirect chain</div>
                                <ul class="url-scan-redirects">
                                    @foreach (var n in aff.Navigation)
                                    {
                                        <li><span class="chip chip-info">hop @n.Hop</span> @n.Network@(string.IsNullOrEmpty(n.AffiliateId) ? "" : $" · ID {n.AffiliateId}") <span class="url-scan-url">@n.Url</span></li>
                                    }
                                </ul>
                                <div class="url-scan-muted">The person who shared this link earns commission on purchases. That's normal when the visitor chooses to open the link.</div>
                            }

                            @if (aff.Impressions?.Any() == true)
                            {
                                <div class="url-scan-muted mt-1">Affiliate impression pixels: @string.Join(", ", aff.Impressions.Select(i => i.Network).Distinct()) (normal ad tracking, not stuffing).</div>
                            }
                            @if (aff.AffiliateCookies?.Any() == true)
                            {
                                <div class="url-scan-muted mt-1">Affiliate network cookies present after load: @string.Join(", ", aff.AffiliateCookies.Select(c => $"{c.Name} ({c.Domain})"))</div>
                            }
                            @if (aff.Verdict == "none")
                            {
                                <div class="url-scan-muted">No affiliate links or background affiliate requests were detected.</div>
                            }
                            <div class="url-scan-muted url-scan-note">ℹ️ @aff.Note</div>
                        }
                        else
                        {
                            <div class="url-scan-muted">Affiliate analysis not available.</div>
                        }
                    </div>

                    <div class="url-scan-card url-scan-wide">
                        <div class="url-scan-card-title">🧩 Frameworks &amp; Dependencies (@(scan.Technologies?.Count ?? 0))</div>
                        @if (scan.Technologies?.Any() == true)
                        {
                            <table class="url-scan-table">
