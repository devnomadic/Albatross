    // Called when component is initialized
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
    
    // Called after the component has rendered
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedReputation = await LoadPreferenceAsync(ReputationPreferenceKey);
            var savedAi = await LoadPreferenceAsync(AiPreferenceKey);
            if (savedReputation.HasValue || savedAi.HasValue)
            {
                enableReputation = savedReputation ?? enableReputation;
                enableAI = savedAi ?? enableAI;
                StateHasChanged();
            }
        }

        if (jsonTreeNeedsRender && showJson && !string.IsNullOrEmpty(formattedJson))
        {
            jsonTreeNeedsRender = false;
            await RenderJsonTreeAsync();
        }

        if (worldMapNeedsRender && showSummary)
        {
            worldMapNeedsRender = false;
            await RenderWorldMapAsync();
        }
    }

    // Renders the collapsible JSON tree viewer (replaces the flat syntax-highlighted <pre> block)
    private async Task RenderJsonTreeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("renderJsonTree", "jsonTreeOutput", formattedJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering JSON tree: {ex.Message}");
        }
    }

